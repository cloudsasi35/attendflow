# AttendFlow Backend Environment Variables

# Application
APP_ENV=development
APP_NAME=AttendFlow
DEBUG=true

# Database
DATABASE_URL=postgresql://attendflow:attendflow@localhost:5432/attendflow

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Timezone
ORG_TIMEZONE=Asia/Kolkata

# Seeding
SEED_DEMO_DATA=true
