# Copy to .env and replace every value with a generated secret.
# Generate one value per variable with:  openssl rand -hex 24
# .env is gitignored. Never commit it.

# Password for the attendflow application database user.
APP_DB_PASSWORD=change-me

# Password for the PostgreSQL superuser (postgres).
POSTGRES_SUPERUSER_PASSWORD=change-me

# Secret used to sign JWT access tokens. Use at least 32 random bytes.
JWT_SECRET_KEY=change-me
