# Copy to observability/.env and replace the value with a generated secret.
# Generate with:  openssl rand -hex 24
# observability/.env is gitignored. Never commit it.

# Password for the Grafana "admin" user.
GRAFANA_ADMIN_PASSWORD=change-me

# Password for the read-only attendflow_monitor PostgreSQL role used by postgres-exporter.
# Generate with:  openssl rand -hex 24
# Create or rotate the role with: config/postgres-exporter/create-monitor-role.sql (see the Stage 2 report for the command).
POSTGRES_EXPORTER_PASSWORD=change-me
